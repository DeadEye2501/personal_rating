# Настройки Personal Rating. Заполните ключи и перезапустите приложение.
#
# Без ключей приложение работает: игры ищутся в Steam, GOG и old-games.ru — они
# ключей не требуют вовсе, — а своя библиотека, оценки, теги и списки работают
# целиком и без сети. Ключи нужны кино с сериалами, книгам и оценкам
# агрегаторов.

# --- Фильмы и сериалы ---
# Без него не найдётся ни один фильм и ни один сериал: источник кино один.
# Где взять: themoviedb.org — зарегистрироваться, затем «Настройки» → «API» →
# ключ версии 3. Бесплатно.
TMDB_API_KEY=

# --- Книги ---
# Без него не найдётся ни одна книга: источник книг один. Google без ключа не
# отвечает вовсе — суточная квота безымянного проекта равна нулю, и на первый
# же запрос приходит отказ.
# Где взять: console.cloud.google.com — завести проект, включить в нём
# «Books API», затем «Credentials» -> «Create credentials» -> «API key».
# Бесплатно, карта не нужна; предел — тысяча запросов в сутки.
GOOGLE_BOOKS_API_KEY=

# --- Музыка ---
# Ключа не требуется: Deezer отвечает без него.

# --- Игры ---
# Ключей не требуется: Steam, GOG и old-games.ru отвечают без них.

# --- Оценки агрегаторов, необязательно ---
# Без них всё работает как обычно, просто на карточке не будет чужих оценок.
# Источники независимы: заполните те, что хотите.

# Оценки IMDb, Rotten Tomatoes и Metacritic одним запросом.
# Где взять: mdblist.com — зарегистрироваться, затем в настройках профиля
# раздел с ключом API.
MDBLIST_API_KEY=

# Оценка IMDb.
# Где взять: omdbapi.com, раздел «API Key» — бесплатный ключ приходит письмом,
# и ссылку в письме надо открыть, иначе ключ не заработает.
OMDB_API_KEY=

# Оценка Кинопоиска. Зеркала два, и второе подхватывает при отказе первого —
# можно заполнить любое одно, можно оба.
# Где взять: poiskkino.dev — ключ выдаёт телеграм-бот, ссылка на него на
# сайте. Старый адрес kinopoisk.dev отвечает переадресацией.
POISKKINO_API_KEY=
# Где взять: kinopoiskapiunofficial.tech — регистрация на сайте, ключ в личном
# кабинете. Есть бесплатный тариф с суточным пределом запросов.
KINOPOISK_UNOFFICIAL_API_KEY=

# --- Прочее ---
# Ступеней в своей оценке: 1 — десять, 0 — пять.
# Смена пересчитывает уже выставленные оценки и стирает прежние значения:
# 10 и 9 становятся пятёркой, обратно пятёрка становится десяткой.
SCALE_X2=1

# Сколько писать в app.log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Куда класть базы и лог. Пусто — папка, в которой лежит этот файл.
DATA_DIR=

# Непустое значение открывает окно с отладочной панелью Chromium.
PR_DEBUG=
