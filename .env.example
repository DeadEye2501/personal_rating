# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# --- Фильмы и сериалы ---
# TMDB API v3, ключ: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Игры ---
# Ключей не требуется: Steam и GOG отвечают без них.

# --- Агрегированные рейтинги (опционально) ---
MDBLIST_API_KEY=
OMDB_API_KEY=
# Кинопоиск: два зеркала, второе подхватывает при отказе первого.
POISKKINO_API_KEY=
KINOPOISK_UNOFFICIAL_API_KEY=

# --- Прочее ---
LOG_LEVEL=INFO
# Куда класть базу, постеры и лог. По умолчанию — папка data рядом с программой.
DATA_DIR=

# Непустое значение открывает окно с отладочной панелью Chromium.
PR_DEBUG=
