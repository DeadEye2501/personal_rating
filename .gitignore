# Секреты
.env

# Данные
*.db
*.db-wal
*.db-shm
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Сборка
build/
dist/
*.spec
*.exe
node_modules/

# Логи
*.log
logs/

# IDE / ОС
.idea/
.vscode/
Thumbs.db
desktop.ini

# Артефакты инструментов
.playwright-mcp/

# Рабочие деревья агентов: там полная копия проекта
# Звёздочкой, а не папкой: закрытую папку git не открывает, и исключение из неё
# не действует вовсе.
.claude/*
# Кроме двух настроек: без них машинная проверка чистоты в свежем клоне молчит
# ровно так же, как если бы всё было чисто. Замерено: файл с четырьмя
# нарушениями даёт ноль находок без `clean.json` и четыре с ним.
!.claude/settings.json
!.claude/clean.json
