{
  "skip": ["docs", "dist"],
  "front": {
    "scope": "client",
    "styles": "styles",
    "allowed": {
      "app": ["components", "state", "api", "styles"],
      "components": ["state", "styles"],
      "state": [],
      "api": [],
      "styles": []
    },
    "aliases": {
      "$styles": "styles",
      "$components": "components",
      "$state": "state",
      "$api": "api"
    },
    "palette": ["styles/palette.css"]
  },
  "maps": {
    "modules": "docs/module-map.md",
    "data": "docs/data-map.md",
    "front": "docs/front-map.md",
    "verdicts": "docs/not-duplicates.md"
  }
}
